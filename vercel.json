{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/cftech.png", "dest": "/cftech.png" },
    { "src": "/placeholder.svg", "dest": "/placeholder.svg" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
